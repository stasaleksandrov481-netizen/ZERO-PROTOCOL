theme_override_constants/separation = 24

[node name="Hero" type="PanelContainer" parent="Margin/Column/Scroll/Content"]
layout_mode = 2

[node name="Inset" type="MarginContainer" parent="Margin/Column/Scroll/Content/Hero"]
layout_mode = 2
