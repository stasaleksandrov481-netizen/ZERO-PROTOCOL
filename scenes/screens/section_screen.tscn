[node name="Summary" type="Label" parent="Margin/Column/Scroll/Content/Hero/Inset/Column"]
layout_mode = 2
theme_override_font_sizes/font_size = 23
autowrap_mode = 3

[node name="Rule" type="HSeparator" parent="Margin/Column/Scroll/Content/Hero/Inset/Column"]
layout_mode = 2

[node name="EmptyRow" type="HBoxContainer" parent="Margin/Column/Scroll/Content/Hero/Inset/Column"]
