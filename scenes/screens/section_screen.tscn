[node name="Header" parent="Margin/Column" instance=ExtResource("2")]
layout_mode = 2
subtitle_key = "SECTION_SUBTITLE"

[node name="Scroll" type="ScrollContainer" parent="Margin/Column"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0
follow_focus = true

[node name="Content" type="VBoxContainer" parent="Margin/Column/Scroll"]
layout_mode = 2
