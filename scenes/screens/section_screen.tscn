[gd_scene load_steps=3 format=3]
[ext_resource type="Script" path="res://scripts/ui/section_screen.gd" id="1"]
[ext_resource type="PackedScene" path="res://scenes/ui/common_header.tscn" id="2"]

[node name="SectionScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
