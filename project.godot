; RIFT: ZERO PROTOCOL — foundation, Godot 4.7.x
config_version=5

[application]
config/name="RIFT: ZERO PROTOCOL"
config/version="0.14.0-live-rig"
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icons/app_icon.svg"

[autoload]
SaveService="*res://scripts/autoload/save_service.gd"
SettingsManager="*res://scripts/autoload/settings_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
NavigationManager="*res://scripts/autoload/navigation_manager.gd"
Expedition="*res://scripts/autoload/expedition_manager.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/min_width=800
window/size/min_height=450
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0
window/energy_saving/keep_screen_on=true

[input]
ui_cancel={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":4194305)]}
future_move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65)]}
future_move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68)]}
future_run={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194325)]}
future_recover={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":82)]}
future_left_hand={"deadzone":0.2,"events":[]}
future_right_hand={"deadzone":0.2,"events":[]}

[input_devices]
pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false
sensors/enable_accelerometer=true

[internationalization]
locale/fallback="ru"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.018,0.028,0.045,1)

[audio]
buses/default_bus_layout="res://resources/configuration/default_bus_layout.tres"

[physics]
common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=12
2d/default_gravity=627.2
2d/solver/solver_iterations=20

[debug]
gdscript/warnings/untyped_declaration=1
